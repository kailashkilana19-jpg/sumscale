# =============================================================================
# OmniAid / SumScale — .gitignore
# =============================================================================

# --- Secrets & environment variables (NEVER COMMIT THESE) ---
.env
.env.local
.env.*.local
.env.production
.env.production.local
.env.development.local
.env.test.local
*.key
*.pem
*.p12
*.pfx
*.crt
*.cer
*.der
secrets/
credentials/
serviceAccountKey.json
firebase-adminsdk*.json
gcloud-credentials*.json

# --- SSH Keys ---
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
*.ppk

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
*.egg
.venv/
venv/
env/
ENV/
.python-version
pip-log.txt
pip-delete-this-directory.txt

# --- Pytest & coverage ---
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.dmypy.json
coverage.xml
*.cover

# --- Uploaded files (never commit user uploads) ---
/backend/uploads/
uploads/
*.pdf
*.docx
*.wav
*.mp3
*.mp4
*.webm
*.ogg
*.avi
*.mov

# --- Node / Frontend ---
node_modules/
frontend/dist/
frontend/.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- OS & editor ---
.DS_Store
Thumbs.db
*.lnk
.idea/
.vscode/
*.swp
*.swo
*~
desktop.ini

# --- Logs ---
*.log
logs/

# --- Database files (never commit local DB data) ---
*.sqlite
*.sqlite3
*.db

# --- Docker ---
.docker/

# --- Temporary files ---
tmp/
temp/
*.tmp
*.bak
*.backup
